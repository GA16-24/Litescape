{
  "name": "litescape",
  "productName": "Litescape",
  "version": "0.3.2",
  "description": "Desktop window for the Litescape mod's 3D schematic viewer, and installer for the mod",
  "author": "GA16-24",
  "homepage": "https://github.com/GA16-24/Litescape",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.ga16.litescape",
    "files": [
      "main.js",
      "instances.js",
      "preload.cjs",
      "settings.html",
      "settings.js",
      "waiting.html",
      "waiting.js"
    ],
    "extraResources": [
      {
        "from": "../build/libs",
        "to": "mod",
        "filter": [
          "*.jar",
          "!*-sources.jar"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "Litescape",
        "schemes": [
          "litescape"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Game",
      "maintainer": "GA16-24 <207302983+GA16-24@users.noreply.github.com>"
    }
  }
}
