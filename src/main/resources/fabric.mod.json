{
  "schemaVersion": 1,
  "id": "litweb",
  "version": "${version}",
  "name": "Litescape",
  "description": "View your Litematica or BuildPrint area selection and placements as live 3D models in your browser. Install on the server too for full-range data in multiplayer.",
  "license": "MIT",
  "icon": "assets/litweb/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.ga16.litweb.LitWeb"],
    "client": ["dev.ga16.litweb.client.LitWebClient"]
  },
  "mixins": ["litweb.mixins.json"],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "litematica": "*"
  },
  "suggests": {
    "buildprint": "*"
  }
}
